# TinyCeNN-LM Docker training defaults for an 8 GB GPU.
# Copy to .env and edit values as needed.

MAX_TOKENS=1000000
CONTEXT_LENGTH=256
BATCH_SIZE=4
GRAD_ACCUM=8
CENN_STEPS=4
LEARNING_RATE=0.002

EVAL_EVERY=25
EVAL_BATCHES=8
EVAL_BATCH_SIZE=4
HEALTH_MIN_IMPROVEMENT=0.002
DIVERGENCE_FACTOR=1.25

# Set to 1 if a finite run that fails to improve should return a non-zero exit code.
FAIL_ON_NO_IMPROVEMENT=0

# Set to 1 if torch.compile causes problems on your GPU/driver.
NO_COMPILE=0

# Optional Hugging Face token; Tiny-LLM and FineWeb are public.
HF_TOKEN=

# Current verified PyTorch runtime image; override for different driver compatibility.
PYTORCH_IMAGE=pytorch/pytorch:2.14.0-cuda12.6-cudnn9-runtime
